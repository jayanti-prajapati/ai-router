# ── Required: set at least one provider ──────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: local model (Ollama / vLLM / LM Studio) ────────────────────────
LOCAL_ENABLED=false
LOCAL_MODEL=llama3
LOCAL_BASE_URL=http://localhost:11434/v1

# ── Routing ───────────────────────────────────────────────────────────────────
MAX_COST_PER_REQUEST=0.05
FALLBACK_TO_CHEAPER_MODEL=true
DAILY_BUDGET_USD=0           # 0 = disabled; circuit-breaks to cheapest tier when exceeded
FORCE_MODEL=                  # global override — every request gets this model (leave blank for normal routing)
ALLOW_CLIENT_FORCE_MODEL=false

# ── Quality ───────────────────────────────────────────────────────────────────
ENABLE_QUALITY_RETRY=true
QUALITY_MIN_SCORE=0.5
ENABLE_META_CLASSIFIER=false
META_CLASSIFIER_MODEL=gpt-4.1-nano

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_URL=                    # leave blank for in-process LRU (single instance only)

# ── Queue (optional, requires REDIS_URL) ──────────────────────────────────────
QUEUE_ENABLED=false

# ── A/B experiments ───────────────────────────────────────────────────────────
# JSON: {"exp-name":{"control":"gpt-4.1-nano","variant":"claude-haiku-4-5","split":0.1}}
AB_EXPERIMENTS={}

# ── Standalone Fastify server (optional) ──────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
